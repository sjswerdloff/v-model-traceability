# DesignContract node schema
# One row per contract (module-level guarantee)
# id_field: id
# csv_file: design_contracts.csv
# optional: approved_by, approval_date
id,title,module,inputs,outputs,guarantees,error_semantics,status,approved_by,approval_date
# id: Unique identifier (e.g., DC-001)
# title: Short human-readable name
# module: Source file or module this contract describes
# inputs: What the module accepts (types, constraints)
# outputs: What the module returns (types, guarantees)
# guarantees: Invariants the module maintains (idempotency, atomicity, etc.)
# error_semantics: How errors are reported and handled
# status: draft|approved|implemented|verified|deprecated
# approved_by: Identity of reviewer who approved this contract (empty for draft).
#              Required when status is approved or beyond. Supports IEC 62304 5.4.
# approval_date: ISO-8601 date of approval (e.g., 2026-05-12). Empty for draft.
